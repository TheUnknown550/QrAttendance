generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormItemType {
  // content blocks (no answer)
  TITLE_TEXT
  IMAGE
  DIVIDER
  SECTION
  // questions
  SHORT_TEXT
  PARAGRAPH
  MULTIPLE_CHOICE
  DROPDOWN
  CHECKBOXES
  NUMBER
  DATE
  EMAIL
  PHONE
  PHOTO
}

enum AttendeeSystemField {
  FIRST_NAME
  SURNAME
  EMAIL
  PHONE
  ORGANIZATION_NAME
  ATTENDEE_TYPE
  ATTENDEE_NUMBER
  PROFILE_PHOTO
}

model User {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String
  email          String                   @unique
  passwordHash   String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganizationMembership[]
  invitesCreated OrganizationInvite[]
  passwordResetTokens PasswordResetToken[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String
  joinCode            String                   @unique
  status              OrganizationStatus       @default(ACTIVE)
  lastActivityAt      DateTime                 @default(now())
  inactiveSinceAt     DateTime?
  scheduledDeletionAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         OrganizationMembership[]
  invites             OrganizationInvite[]
  attendees           Attendee[]
  eventSeries         EventSeries[]
  attendeeTypes       AttendeeType[]
  forms               Form[]
  requireAttendeeEmail  Boolean @default(false) @map("require_attendee_email")
  requireAttendeePhone  Boolean @default(false) @map("require_attendee_phone")
  requireAttendeeNumber Boolean @default(false) @map("require_attendee_number")
  qrTemplateImageUrl    String? @map("qr_template_image_url")
  qrTemplateX           Int?    @map("qr_template_x")
  qrTemplateY           Int?    @map("qr_template_y")
  qrTemplateSize        Int?    @map("qr_template_size")

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model OrganizationInvite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  createdByUserId String      @db.Uuid
  token          String       @unique
  expiresAt      DateTime?
  usedCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_invites")
}

model EventSeries {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                   String
  description            String?
  startDate              DateTime?
  endDate                DateTime?
  requireCheckInApproval Boolean        @default(true) @map("require_check_in_approval")
  showOrganizationName   Boolean        @default(true) @map("show_organization_name")
  showAttendeeType       Boolean        @default(true) @map("show_attendee_type")
  showPhone              Boolean        @default(true) @map("show_phone")
  showEmail              Boolean        @default(true) @map("show_email")
  showAttendeeNumber     Boolean        @default(true) @map("show_attendee_number")
  requireCheckInPhoto    Boolean        @default(false) @map("require_check_in_photo")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  sessions               EventSession[]
  forms                  Form[]

  @@index([organizationId])
  @@unique([organizationId, name])
  @@map("event_series")
}

model EventSession {
  id            String             @id @default(uuid()) @db.Uuid
  eventSeriesId String             @db.Uuid
  eventSeries   EventSeries        @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  sessionDate   DateTime
  publicScanToken String?          @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attendance    AttendanceRecord[]

  @@index([eventSeriesId])
  @@map("event_sessions")
}

model Attendee {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firstName        String
  surname          String
  organizationName String?            @map("organization_name")
  attendeeType     String?            @map("attendee_type")
  email            String?
  phone            String?
  attendeeNumber   Int?               @map("attendee_number")
  profileImageUrl  String?
  qrToken          String             @unique
  emailedAt        DateTime?          @map("emailed_at")
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attendance       AttendanceRecord[]
  formResponses    FormResponse[]

  @@index([organizationId])
  @@map("attendees")
}

model AttendeeType {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, label])
  @@index([organizationId])
  @@map("attendee_types")
}

model AttendanceRecord {
  id             String       @id @default(uuid()) @db.Uuid
  attendeeId     String       @db.Uuid
  eventSessionId String       @db.Uuid
  attendee       Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  checkedInAt    DateTime     @default(now())
  checkInPhotoUrl String?     @map("check_in_photo_url")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([attendeeId, eventSessionId])
  @@index([eventSessionId])
  @@map("attendance_records")
}

model Form {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventSeriesId  String?        @db.Uuid
  eventSeries    EventSeries?   @relation(fields: [eventSeriesId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         FormStatus     @default(DRAFT)
  publicToken    String         @unique @map("public_token")
  theme          Json?
  settings       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          FormItem[]
  responses      FormResponse[]

  @@index([organizationId])
  @@map("forms")
}

model FormItem {
  id          String               @id @default(uuid()) @db.Uuid
  formId      String               @db.Uuid
  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        FormItemType
  systemField AttendeeSystemField? @map("system_field")
  position    Int
  label       String?
  description String?
  imageUrl    String?              @map("image_url")
  required    Boolean              @default(false)
  config      Json?
  archivedAt  DateTime?            @map("archived_at")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  options     FormItemOption[]
  answers     FormAnswer[]

  @@unique([formId, systemField])
  @@index([formId, position])
  @@map("form_items")
}

model FormItemOption {
  id         String    @id @default(uuid()) @db.Uuid
  itemId     String    @db.Uuid
  item       FormItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label      String
  imageUrl   String?   @map("image_url")
  position   Int
  archivedAt DateTime? @map("archived_at")

  @@index([itemId, position])
  @@map("form_item_options")
}

model FormResponse {
  id                      String       @id @default(uuid()) @db.Uuid
  formId                  String       @db.Uuid
  form                    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  attendeeId              String?      @db.Uuid
  attendee                Attendee?    @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  matchedExistingAttendee Boolean      @default(false) @map("matched_existing_attendee")
  submittedAt             DateTime     @default(now()) @map("submitted_at")
  ipAddress               String?      @map("ip_address")
  userAgent               String?      @map("user_agent")
  answers                 FormAnswer[]

  @@index([formId, submittedAt])
  @@index([attendeeId])
  @@map("form_responses")
}

model FormAnswer {
  id          String       @id @default(uuid()) @db.Uuid
  responseId  String       @db.Uuid
  response    FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  itemId      String       @db.Uuid
  item        FormItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  textValue   String?      @map("text_value")
  numberValue Decimal?     @map("number_value")
  dateValue   DateTime?    @map("date_value")
  optionIds   String[]     @default([]) @map("option_ids") @db.Uuid

  @@unique([responseId, itemId])
  @@index([itemId])
  @@map("form_answers")
}
